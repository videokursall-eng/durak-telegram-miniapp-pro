# Local development — copy to .env.local (not committed).
# Backend must be running (e.g. http://127.0.0.1:8080). Do not use for Telegram launch — use a tunnel/production URL in BotFather.

VITE_APP_ENV=development
VITE_APP_MODE=development
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_WS_BASE_URL=ws://127.0.0.1:8080
VITE_ISOLATED_DEV_MODE=0
VITE_TELEGRAM_ONLY=0
