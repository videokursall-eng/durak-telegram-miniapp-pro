# Web (frontend) env — used at build time. Copy to .env or .env.production.
# For local development use .env.local (see .env.local.example).

# -----------------------------------------------------------------------------
# App mode: development | production
# development = dev auth allowed when running in Vite dev server; production = Telegram auth only.
# -----------------------------------------------------------------------------
VITE_APP_ENV=production
# Optional alias (if you prefer this name):
# VITE_APP_MODE=production

# -----------------------------------------------------------------------------
# Backend URLs (HTTPS/WSS in production; Telegram cannot use localhost)
# Set these to the real backend so the Mini App can call API and WebSocket.
# -----------------------------------------------------------------------------
# Base origin for API and WS (e.g. https://api.your-domain.com). Used when VITE_API_BASE_URL / VITE_WS_URL not set.
VITE_SERVER_ORIGIN=

# Full API base URL (optional; overrides VITE_SERVER_ORIGIN for fetch).
VITE_API_BASE_URL=

# WebSocket base URL (optional; e.g. wss://api.your-domain.com). Path /ws is appended if not present.
VITE_WS_BASE_URL=

# Full WebSocket URL (optional; overrides VITE_WS_BASE_URL and VITE_SERVER_ORIGIN for WS).
VITE_WS_URL=

# -----------------------------------------------------------------------------
# Telegram Mini App (for sharing links, display; must be HTTPS)
# Mini App URL in BotFather must point to a real HTTPS address — never localhost.
# -----------------------------------------------------------------------------
# Public URL of this Mini App (HTTPS). Must match the URL set in BotFather (Menu Button / Web App).
VITE_TELEGRAM_MINI_APP_URL=

# Bot username without @ (for display or t.me links).
VITE_TELEGRAM_BOT_USERNAME=

# Short name of the Mini App (for display).
VITE_TELEGRAM_MINI_APP_SHORT_NAME=

# -----------------------------------------------------------------------------
# Optional: Telegram-only mode (1 = require Telegram; no dev auth even in dev build).
# -----------------------------------------------------------------------------
# VITE_TELEGRAM_ONLY=0

# Optional: isolated demo (local-only, no backend). 1 = enable demo fallback when no auth.
# VITE_ISOLATED_DEV_MODE=0
