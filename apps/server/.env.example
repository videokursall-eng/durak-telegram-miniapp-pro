# Server env — copy to .env and set for your environment.
# Do not commit .env (secrets). Three modes below.

# =============================================================================
# 1. LOCAL DEVELOPMENT
# =============================================================================
# Backend on 127.0.0.1; dev auth enabled so you can test without Telegram.
# Web (Vite) uses .env.local with VITE_API_BASE_URL=http://127.0.0.1:8080.

HOST=127.0.0.1
PORT=8080
APP_ENV=development
DEPLOY_PLATFORM=local
TRUST_PROXY=false

# CORS: allow Vite dev server.
PUBLIC_WEB_APP_URL=http://localhost:5173
# Optional: explicit list (PUBLIC_WEB_APP_URL is appended if set).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: set TELEGRAM_BOT_TOKEN to test Telegram auth locally.
# TELEGRAM_BOT_TOKEN=

# =============================================================================
# 2. PUBLIC TUNNEL / DOMAIN (for Telegram Mini App testing)
# =============================================================================
# Backend and web are reachable via HTTPS (e.g. ngrok, Cloudflare Tunnel, or a staging domain).
# Telegram can open only HTTPS URLs — never use localhost in BotFather Mini App URL.
# Align: BotFather Mini App URL = frontend URL; CORS and PUBLIC_WEB_APP_URL = same URL;
#        backend on a separate host or same host with correct CORS.

# APP_ENV=development
# HOST=0.0.0.0
# PORT=8080
# TRUST_PROXY=true
# TELEGRAM_BOT_TOKEN=<from BotFather>

# Public URL of the web app (HTTPS). Set this in BotFather as Mini App URL.
# PUBLIC_WEB_APP_URL=https://your-tunnel-or-staging.pages.dev

# Backend base URL (HTTPS). If same host as web, use same origin.
# PUBLIC_BASE_URL=https://api.your-tunnel.example.com

# CORS: must include the exact origin of the Mini App (PUBLIC_WEB_APP_URL).
# CORS_ALLOWED_ORIGINS=https://your-tunnel-or-staging.pages.dev

# =============================================================================
# 3. PRODUCTION (Telegram Mini App) — single-origin
# =============================================================================
# APP_ENV=production disables dev auth. Only Telegram auth; TELEGRAM_BOT_TOKEN required.
# Single-origin: one domain for frontend, API, WebSocket (no CORS/WS origin issues).
# Build frontend first: pnpm build. Server serves apps/web/dist and handles /auth/telegram, /ws.

# APP_ENV=production
# HOST=127.0.0.1
# PORT=8080
# TRUST_PROXY=true
# TELEGRAM_BOT_TOKEN=<from BotFather>

# Single domain (BotFather Mini App URL = this URL).
# PUBLIC_BASE_URL=https://app.rasklad-taro.online
# PUBLIC_WEB_APP_URL=https://app.rasklad-taro.online

# CORS: same origin (optional if only Mini App opens the app).
# CORS_ALLOWED_ORIGINS=https://app.rasklad-taro.online

# Optional: path to frontend build. Default: ../../web/dist relative to server dist.
# STATIC_ROOT=/var/app/web/dist

# =============================================================================
# 4. VPS PRODUCTION (no Docker, no cloudflared — nginx → Node)
# =============================================================================
# Domain: app.games-telegram.online → nginx (HTTPS) → 127.0.0.1:8080
# Copy to .env on VPS and set TELEGRAM_BOT_TOKEN. Then: pnpm build && pm2 start.

# HOST=127.0.0.1
# PORT=8080
# APP_ENV=production
# DEPLOY_PLATFORM=vps
# TRUST_PROXY=true
# PUBLIC_BASE_URL=https://app.games-telegram.online
# PUBLIC_WEB_APP_URL=https://app.games-telegram.online
# TELEGRAM_BOT_TOKEN=<from BotFather>
# TELEGRAM_BOT_USERNAME=Verovoy_Bot
# TELEGRAM_MINI_APP_SHORT_NAME=durak
# AUTH_TOKEN_TTL_SECONDS=86400
# TELEGRAM_INITDATA_TTL_SECONDS=3600
# CORS_ALLOWED_ORIGINS=https://app.games-telegram.online
# Optional: DATABASE_URL=postgres://...  REDIS_URL=redis://...  (if added later)
