# VPS production — copy to apps/server/.env and set TELEGRAM_BOT_TOKEN.
# Domain: https://app.games-telegram.online → nginx → 127.0.0.1:8080

HOST=127.0.0.1
PORT=8080

APP_ENV=production
DEPLOY_PLATFORM=vps
TRUST_PROXY=true

PUBLIC_BASE_URL=https://app.games-telegram.online
PUBLIC_WEB_APP_URL=https://app.games-telegram.online

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Verovoy_Bot
TELEGRAM_MINI_APP_SHORT_NAME=durak

AUTH_TOKEN_TTL_SECONDS=86400
TELEGRAM_INITDATA_TTL_SECONDS=3600

CORS_ALLOWED_ORIGINS=https://app.games-telegram.online

# Optional (server does not use these yet):
# DATABASE_URL=postgres://...
# REDIS_URL=redis://...
