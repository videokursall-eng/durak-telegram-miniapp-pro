{
  "name": "@durak/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @durak/shared build && tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "lint": "echo todo",
    "test": "pnpm --filter @durak/shared build && tsc && node --test tests/**/*.test.mjs",
    "verify:local": "pnpm exec node scripts/verify-local.mjs"
  },
  "dependencies": {
    "@durak/shared": "workspace:*",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}